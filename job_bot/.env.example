# Environment Variables Template for Job Bot
# ================================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and fill in YOUR actual values
# 3. NEVER commit .env to git (it's in .gitignore)
# 4. NEVER share .env in public or with anyone
# ================================================

# ========== REQUIRED SETTINGS ==========

# Serper API Key - Get from https://serper.dev (100 free searches/month)
# Sign up at https://serper.dev, copy your API key below
SERPER_API_KEY=your_serper_api_key_here

# ========== OLLAMA (Local LLM) ==========

# Ollama Base URL - Local LLM endpoint (should not change unless running on different machine)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama Model - Which model to use
# Options: mistral (recommended), neural-chat, llama2, dolphin-mixtral
OLLAMA_MODEL=mistral

# ========== APPLICATION SETTINGS ==========

# Fit Score Threshold - Only draft cover letters for jobs scoring >= this
# Range: 0-100 (default: 65 is good balance)
FIT_SCORE_THRESHOLD=65

# Maximum Results per Query - How many jobs to process per search
# Recommendation: 5-10 (higher = slower, more thorough)
MAX_RESULTS_PER_QUERY=5

# ========== ADVANCED: AUTOMATED APPLICATIONS ==========
# WARNING: Auto-submission may violate job board Terms of Service!
# Only enable if you understand the risks. Use at your own risk.

# Enable automated application submission
# false (default) = requires manual confirmation
# true = enables browser automation for Easy Apply
ENABLE_APPLY=false

# Auto-submit without confirmation
# false (default, RECOMMENDED) = prompt before each submission
# true = auto-submit everything (USE WITH EXTREME CAUTION!)
AUTO_APPLY=false
